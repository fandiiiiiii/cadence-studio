# Optional: move runtime data to another folder.
# CADENCE_DATA_DIR=F:\CadenceData

# Optional defaults for development; the UI stores secrets in Windows DPAPI.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# Local server port; the launcher picks 8765–8794 if busy.
# CADENCE_PORT=8765
